survey <- flat |>
select(child_hashed_id, exp_data_trial_type, exp_data_response) |>
filter(exp_data_trial_type == "survey") |>
unnest(exp_data_response) |>
distinct(child_hashed_id, exp_data_response) |>
pivot_wider(names_from = exp_data_response,
values_from = exp_data_response)
View(survey)
survey <- flat |>
select(child_hashed_id, exp_data_trial_type, exp_data_response) |>
filter(exp_data_trial_type == "survey") |>
unnest(exp_data_response) |>
distinct(child_hashed_id, exp_data_response) |>
mutate(email = case_when(str_detect(exp_data_response, "@") ~ exp_data_response,
TRUE ~ NA))
View(survey)
survey <- flat |>
select(child_hashed_id, exp_data_trial_type, exp_data_response) |>
filter(exp_data_trial_type == "survey") |>
unnest(exp_data_response) |>
distinct(child_hashed_id, exp_data_response) |>
mutate(email = case_when(str_detect(exp_data_response, "@") ~ exp_data_response,
TRUE ~ NA_character_),
email = case_when(str_detect("") ~ NA_character_,
TRUE ~ email))
