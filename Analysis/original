            "blocks": [
                {
                    "title": "Instructions",
                    "listblocks": [
                        {
                            "text": "In this session, your child will play two short games meant to understand your child's cognitive thinking."
                        },
                        {
                            "text": "Your child will use the mouse or trackpad to select their response. If your child is unable to click on their own, you may click on the response they have selected. But remember to select your child's response- we want to know what they think!"
                        },
                        {
                            "text": "Please do not turn down or turn off your device's volume during the games (Adjusting the volume before games is okay!)."
                        },
                        {
                            "text": "If your child needs a break at any time, press the space bar to pause the session. Please note that if the session is paused during a video, that video will replay from the beginning when the session resumes."
                        }
                    ]
